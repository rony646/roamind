{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @roamind/shared build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @roamind/shared build",
    "build": "nest build",
    "lint": "eslint .",
    "pretest": "pnpm --filter @roamind/shared build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @roamind/shared build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.8.0",
    "@roamind/shared": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
