{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "PORT",
    "NEON_CONNECTION_STRING",
    "JWT_SECRET",
    "ALLOW_SIGNUP",
    "OPEN_UNCENSORED_API_KEY",
    "OPEN_UNCENSORED_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "//#lint:root": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
